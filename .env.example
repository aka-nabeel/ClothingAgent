# Server Application Configuration
PORT=8000
APP_PORT=8000
PUBLIC_ORIGIN=http://localhost:8000

# PostgreSQL Database Configuration (Set in your .env file)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ClothingAppDummyDB
CLOTHING_APP_DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@127.0.0.1:5432/ClothingAppDummyDB

# Groq LLM API Key
GROQ_API_KEY=your_groq_api_key_here
CLOTHING_AGENT_LLM_API_KEY=your_groq_api_key_here
CLOTHING_AGENT_LLM_API_BASE=https://api.groq.com/openai/v1
CLOTHING_AGENT_LLM_MODEL=openai/gpt-oss-120b
CLOTHING_AGENT_CLOTHING_APP_BASE_URL=http://127.0.0.1:8000
CLOTHING_AGENT_ALLOW_LOCAL_FALLBACK=true

# Optional tuning
CLOTHING_AGENT_DISPLAYED_PRODUCT_LIMIT=3
CLOTHING_AGENT_MAXIMUM_CLARIFICATION_QUESTIONS=2
CLOTHING_APP_DATABASE_POOL_SIZE=5
CLOTHING_APP_DATABASE_MAX_OVERFLOW=5
